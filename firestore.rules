rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Topics — public read, no client writes
    match /topics/{topicId} {
      allow read: if true;
      allow write: if false;
    }
    // Questions — public read, no client writes
    match /questions/{questionId} {
      allow read: if true;
      allow write: if false;
    }
  }
}

