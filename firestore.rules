rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper ──────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ── Topics ──────────────────────────────────────────────
    match /topics/{topicId} {
      allow read:  if true;
      allow write: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();  // Soft delete: admin sets deletedAt field
    }

    // ── Questions ────────────────────────────────────────────
    match /questions/{questionId} {
      allow read:  if true;
      allow write: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();  // Soft delete: admin sets deletedAt field
    }

    // ── Users ────────────────────────────────────────────────
    // Users can read their own profile (needed for role check on login)
    // Allow create so Google sign-in can auto-create the profile doc
    match /users/{uid} {
      allow read:   if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.role == 'user';
      allow update: if false;
      allow delete: if false;
    }

    // ── Notes ────────────────────────────────────────────────
    // Each note doc ID is `{userId}_{questionId}`
    // Only the owner can read, write, or delete their own notes
    match /notes/{noteId} {
      allow read,  delete: if request.auth != null
                           && resource.data.userId == request.auth.uid;
      allow create:        if request.auth != null
                           && request.resource.data.userId == request.auth.uid;
      allow update:        if request.auth != null
                           && resource.data.userId == request.auth.uid
                           && request.resource.data.userId == request.auth.uid;
    }
  }
}
